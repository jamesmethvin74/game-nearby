{
  "name": "localbleachersar-sports-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/worker.js && node --check ../live-data.js && node --test test/*.test.js",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "deploy:cloudflare": "npm run check && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply localbleachersar-sports --local",
    "db:migrate:remote": "wrangler d1 migrations apply localbleachersar-sports --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
