{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "localbleachersar-sports-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "https://jamesmethvin74.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "localbleachersar-sports",
      "database_id": "REPLACE_AFTER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
